{
  "name": "@sgnl/snowflake-grant-sync",
  "description": "Sync SGNL access decisions to Snowflake sgnl_access_grants table via the SQL API",
  "version": "1.0.0",
  "license": "MIT",
  "author": "SGNL Engineering",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "rollup": "^4.59.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5"
  },
  "keywords": [
    "sgnl",
    "job",
    "snowflake",
    "grants",
    "row-access-policy",
    "identity",
    "security"
  ]
